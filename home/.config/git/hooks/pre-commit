#!/bin/sh
status=0
if [ -e license.txt ]; then
    mvn license:format >/dev/null 2>&1
    status=$?
    if [ $status -ne 0 ]; then
        echo 'writing copy right aborted due to error during adding copyright'
        # even if some error occur, commit process can be proceed
        status=0
    fi
fi

if [ -e pom.xml ]; then
    mvn org.codehaus.mojo:license-maven-plugin:third-party-report >/dev/null 2>&1
    status=$?
    if [ $status -ne 0 ]; then
        echo 'reporting third party license aborted due to error during reporting'
        # even if some error occur, commit process can be proceed
        status=0
    else
        # check if third-party-report.html has updates (suppress file changes due to date)
        git diff HEAD --unified=0 third-party-report.html | grep -E '^[+-]' | grep -Ev '^(--- a/|\+\+\+ b/)' \
        | grep -Fv "Generated by Apache Maven Doxia Site Renderer" | grep -Fv "publishDate" >/dev/null 2>&1
        is_not_updated=$?
        if [ $is_not_updated -ne 0 ]; then
            # revert to HEAD if not updated
            git checkout HEAD third-party-report.html
            git add third-party-report.html
            status=0
        else
            printf "\e[33m" 1>&2
            echo '"third-party-report.html" updated and committed'
            printf "\e[m" 1>&2
            git add third-party-report.html
            status=0
        fi
    fi
fi
exit $status
